# ─── Analytics ────────────────────────────────────────────────
# Copiază fișierul în `.env.local` pentru dezvoltare, iar în producție
# setează variabilele în panoul de hosting (Netlify / Vercel → Environment
# variables). Ambele sunt opționale: dacă lipsesc, scriptul nu se încarcă.

# Google Analytics 4 → Admin → Data streams → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Implicit, tracking-ul rulează doar în producție, ca să nu murdărești
# datele clientului cu sesiunile tale de dezvoltare. Pune `true` doar
# temporar, cât verifici că evenimentele ajung unde trebuie.
# NEXT_PUBLIC_ANALYTICS_DEBUG=true
